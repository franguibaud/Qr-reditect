# Copiá estas variables en Vercel: tu proyecto -> Settings -> Environment Variables
# (No hace falta un archivo .env local para que funcione en Vercel, esto es solo de referencia)

# Project Settings -> API en Supabase:
SUPABASE_URL=https://TU-PROYECTO.supabase.co

# La clave "publishable" (antes se llamaba "anon key") — es pública, solo lee.
SUPABASE_PUBLISHABLE_KEY=

# La clave "secret" (antes se llamaba "service_role key") — NUNCA la pongas en el
# frontend ni la subas a un repo público. Solo la usan las funciones del panel
# (crear.js, editar.js, listar.js) para poder escribir en la base saltando la
# proteccion de lectura publica.
SUPABASE_SECRET_KEY=

# La contraseña para entrar al panel de /  (la elegís vos, cualquier texto).
ADMIN_PASSWORD=
